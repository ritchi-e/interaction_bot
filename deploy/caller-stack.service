[Unit]
Description=Start the caller app, Dograh, and Maya 2 Native TTS
After=docker.service
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/data/caller/interaction_bot/deploy/boot-services.sh
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
