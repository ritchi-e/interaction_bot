{$APP_DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /webhooks/* {
		reverse_proxy backend:8000
	}
	handle /admin/* {
		reverse_proxy backend:8000
	}
	handle /health* {
		reverse_proxy backend:8000
	}
	handle /static/* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:3000
	}
}
