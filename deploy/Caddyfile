{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2
	}
}

# The cloud network drops port 3010 before it reaches this machine.
# The Dograh UI is served on port 80 for requests to the public IP.
http://144.24.7.240 {
	handle /api/v1/* {
		reverse_proxy dograh-api-1:8000
	}
	handle {
		reverse_proxy dograh-ui-1:3010
	}
}

dograh.{$APP_DOMAIN} {
	reverse_proxy dograh-api-1:8000 {
		flush_interval -1
	}
}

www.{$APP_DOMAIN}, {$APP_DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /webhooks/* {
		reverse_proxy backend:8000
	}
	handle /admin/* {
		reverse_proxy backend:8000
	}
	handle /health* {
		reverse_proxy backend:8000
	}
	handle /static/* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:3000
	}
}
