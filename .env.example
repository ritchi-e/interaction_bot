# Copy to .env and replace every secret before deploying.
# Generate a Fernet key with:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
# Include the public domain, and "backend" so the context guard on the docker network is accepted.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,phonwa.online,www.phonwa.online
FERNET_KEY=replace-with-a-generated-fernet-key
DATABASE_URL=postgres://caller:caller@postgres:5432/caller
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Shared with context_guard. Long random string.
INTERNAL_API_TOKEN=change-me-internal

# Self-hosted Dograh (API port from its compose file, usually 8000).
DOGRAH_API_URL=http://dograh-api:8000
DOGRAH_API_KEY=
DOGRAH_WEBHOOK_SECRET=change-me-dograh-webhook

# Self-hosted speech (GPU). Leave defaults for in-cluster Docker networking.
SPEECH_STT_URL=http://speech-stt:8000
SPEECH_TTS_URL=http://speech-tts:8000/v1
# Optional shared secret checked by speech-stt / speech-tts. Dograh sends it as
# Authorization: Token <value> (Deepgram style) / Bearer for OpenAI TTS.
SPEECH_API_TOKEN=
# Default gender token when a campaign has no tts_voice set (female|male).
SPEECH_VOICE_NAME=female
# Hugging Face token for gated model downloads (speech-models job).
HF_TOKEN=
TTS_NFE=16

# Language model behind the context guard. Any OpenAI-compatible chat API works.
# Gemini via OpenAI compatibility: https://generativelanguage.googleapis.com/v1beta/openai
UPSTREAM_LLM_BASE_URL=https://api.openai.com/v1
UPSTREAM_LLM_API_KEY=
UPSTREAM_LLM_MODEL=gpt-4o-mini
BACKEND_INTERNAL_URL=http://backend:8000

SIP_HOSTNAME=sip.example.com
PUBLIC_BASE_URL=https://app.example.com
ASTERISK_CONFIG_DIR=
ASTERISK_AMI_HOST=
ASTERISK_AMI_SECRET=

NEXT_PUBLIC_API_URL=http://localhost:8000
APP_DOMAIN=localhost
ACME_EMAIL=ops@example.com
